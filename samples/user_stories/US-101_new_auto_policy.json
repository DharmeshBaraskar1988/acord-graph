        "insuredVehicles": [
          {"vin": "1HGCM82633A004352", "modelYear": "2022", "manufacturer": "Honda", "vehicleBodyTypeCd": "SED", "vehicleUseCd": "Commute",
           "drivers": [{"id": "P-1", "partyTypeCd": "Person", "name": {"givenName": "Asha", "surname": "Rao"}, "licenseNumber": "TX1234567", "licenseStateProvCd": "TX"}]}
        ]
      }
    }
  ]
