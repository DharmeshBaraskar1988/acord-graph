        "expirationDt": "2027-05-01",
        "writtenPremiumAmt": 742.5,
        "namedInsured": {
          "id": "P-1",
          "partyTypeCd": "Person",
          "name": {"givenName": "Asha", "surname": "Rao"},
          "addresses": [{"addressTypeCd": "MailingAddress", "addr1": "12 Elm St", "city": "Austin", "stateProvCd": "TX", "postalCode": "73301", "countryCd": "US"}],
          "communications": [{"communicationTypeCd": "Email", "value": "asha@example.com"}]
        },
        "coverages": [
